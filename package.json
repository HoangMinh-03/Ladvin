{
  "name": "ladvin-workspace",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "test": "bun test packages",
    "build:hub": "bun build packages/hub/src/main.ts --target=node --outfile dist/ladvin-mcp.js",
    "build:agentd": "bun build --compile packages/agentd/src/main.ts --outfile build/ladvin-agentd"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
